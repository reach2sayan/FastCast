<?xml version="1.0" encoding="utf-8"?>
<!-- Native, header-only NuGet package for MSVC / Visual Studio consumers.
     Packed from the repository root by the release workflow:
       nuget pack contrib/nuget/FastCast.nuspec -Version X.Y.Z -BasePath . -OutputDirectory nupkg
     Layout inside the .nupkg:
       build/native/FastCast.targets      wires the include path into every vcxproj
       build/native/include/fastcast.hpp  the library
       README.md, LICENSE.txt -->
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>FastCast</id>
    <version>$version$</version>
    <authors>Sayan</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/reach2sayan/FastCast</projectUrl>
    <repository type="git" url="https://github.com/reach2sayan/FastCast.git" />
    <readme>README.md</readme>
    <description>A cached, header-only, drop-in replacement for dynamic_cast.
fast_cast caches the vtable-to-offset result of each cast per thread, so repeated
casts of the same dynamic type cost a compare and an add instead of an RTTI walk,
while returning exactly what dynamic_cast would. Pointer, reference and
std::shared_ptr overloads. Native, header-only, C++11 and later, any platform
and architecture; referencing the package adds the include path.</description>
    <tags>native header-only dynamic_cast rtti cast performance cpp cpp11</tags>
  </metadata>
  <files>
    <file src="contrib\nuget\FastCast.targets" target="build\native" />
    <file src="fastcast.hpp" target="build\native\include" />
    <file src="README.md" target="" />
    <file src="LICENSE.txt" target="" />
  </files>
</package>
